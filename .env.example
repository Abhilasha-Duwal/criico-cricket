# PostgreSQL connection string used by the Prisma Client at runtime.
# Copy this file to `.env` and replace the placeholders with your local values.
# Never commit `.env` or real database credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/criico_cricket?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate.
# For Neon, use the direct host (without "-pooler"); locally this can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/criico_cricket?schema=public"

# Secret used to sign and verify JWT session tokens.
# Use a long random value of at least 32 characters, for example: openssl rand -hex 32
# Never expose this value to client components or commit it to Git.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional: controls Prisma client logging in src/lib/prisma.ts
NODE_ENV="development"
